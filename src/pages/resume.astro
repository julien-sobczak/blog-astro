---
import { Image } from "astro:assets";
import {
  EyesIcon,
  PencilSimpleIcon,
  MicrophoneIcon,
  SmileyIcon,
  CakeIcon,
  CompassIcon,
  AtIcon,
  PhoneIcon,
  PencilIcon,
  GithubLogoIcon,
  HeartIcon,
  BookIcon,
  PingPongIcon,
  CameraIcon,
  MountainsIcon,
  PersonSimpleRunIcon,
  BackpackIcon,
  BoatIcon,
  LinkedinLogoIcon,
  // SpeakerLowIcon,
  // ImageIcon,
  CheckCircleIcon,
  TargetIcon,
  LinkIcon,
  CalendarDotsIcon,
  MapPinIcon,
} from "@phosphor-icons/react";
import "../styles/resume.css";
import meImage from "../assets/julien-portrait-transparent.png";
import qrLinkedInImage from "../assets/qr-linkedin-julien.svg";
// QR Codes were generated using https://www.qrcode-monkey.com/fr/
import qrBlogImage from "../assets/qr-blog-dark.svg";
import qrTheNotewriterImage from "../assets/qr-the-notewriter-documentation-dark.svg";
const email = import.meta.env.PERSONAL_EMAIL;
const phoneNumber = import.meta.env.PERSONAL_PHONE_NUMBER;
const birthDate = import.meta.env.PERSONAL_BIRTH_DATE;
console.log("PHONE NUMBER:", phoneNumber);
console.log("EMAIL:", email);
console.log("BIRTH DATE:", birthDate);
---

<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <title>My Resume</title>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Source+Sans+3:ital,wght@0,200..900;1,200..900&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Source+Code+Pro:ital,wght@0,200..900;1,200..900&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Caveat:wght@400..700&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Emoji:wght@300..700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <!-- First page: Me -->
    <page id="first" size="A4" orientation="landscape">
      <header>
        <div id="name">
          <h2>Julien</h2>
          <h1>Sobczak</h1>
          <h3>{`{Software Developer + Husband + Dad}`}</h3>
        </div>

        <div id="picture">
          <Image src={meImage} alt="It's me" />
        </div>
        <div id="tagline" class="speech">
          <span id="tagline-hi"
            ><strong>Thanks</strong> for spending a few minutes getting to know me.</span
          >
          <span id="tagline-me"
            >Serious about my work without never taking myself too seriously.</span
          >
          <!--
            NB: Commented out as not inspired enough to record a good audio
            <sup id="play-tagline-audio"><SpeakerLowIcon size={16} weight="fill" aria-label="I'm serious but playful" /></sup>
            <script type="text/javascript" is:inline>
              document.addEventListener('DOMContentLoaded', function () {
                const btn = document.getElementById('play-tagline-audio');
                if (btn) {
                  btn.addEventListener('click', function () {
                    new Audio('/img/resume-me.wav').play();
                  });
                }
              });
            </script>
            -->
        </div>

        <ul id="contact">
          {
            birthDate && (
              <li>
                <span class="picto">
                  <CakeIcon size={16} weight="fill" aria-label="Birthday" />
                </span>{" "}
                {birthDate}
              </li>
            )
          }
          <li>
            <span class="picto"
              ><CompassIcon
                size={16}
                weight="fill"
                aria-label="Location"
              /></span
            > Douai, France
          </li>
          {
            email && (
              <li>
                <span class="picto">
                  <AtIcon size={16} weight="fill" aria-label="Email" />
                </span>{" "}
                {email}
              </li>
            )
          }
          {
            phoneNumber && (
              <li>
                <span class="picto">
                  <PhoneIcon size={16} weight="fill" aria-label="Phone" />
                </span>{" "}
                {phoneNumber}
              </li>
            )
          }
          <li>
            <span class="picto"
              ><PencilIcon size={16} weight="fill" aria-label="Website" /></span
            > https://www.juliensobczak.com
          </li>
          <li>
            <span class="picto"
              ><GithubLogoIcon
                size={16}
                weight="fill"
                aria-label="GitHub"
              /></span
            > https://github.com/julien-sobczak
          </li>
        </ul>
      </header>

      <section id="skills">
        <div class="legend">
          <span class="ignorant">Apprentice</span> → <span class="intermediate"
            >Journeyman</span
          > → <span class="master">Master</span> / <span class="highlight"
            ><span class="emoji">😍</span>
            <span class="manuscript">Enjoy</span></span
          >
        </div>
        <div class="hard-skills">
          <dl>
            <dt>Code</dt>
            <dd>
              <span class="expert highlight">Go</span> / <span
                class="intermediate highlight">Python</span
              > / <span class="advanced">Java</span> / <span
                class="intermediate">TypeScript</span
              > / <span class="beginner">Bash</span> / <span class="advanced"
                >SQL</span
              > / <span class="expert">Git</span> / <span
                class="intermediate highlight">CSS</span
              > / <span class="intermediate">React</span> / <span
                class="intermediate highlight">AI-Assisted Programming</span
              >
            </dd>

            <dt>Design</dt>
            <dd>
              <span class="advanced">System Design</span> / <span
                class="intermediate">Design Patterns</span
              > / <span class="advanced highlight">DDD</span> / <span
                class="advanced highlight">Automated Testing</span
              > / <span class="advanced">REST</span> / <span
                class="intermediate">gRPC</span
              >
            </dd>

            <dt>Build</dt>
            <dd>
              <span class="advanced">GitLab CI</span> / <span
                class="intermediate">GitHub Actions</span
              >
            </dd>

            <dt>Ship</dt>
            <dd>
              <span class="advanced">Linux</span> / <span class="advanced"
                >Docker</span
              > / <span class="beginner highlight">Kubernetes</span>
            </dd>

            <dt>Run</dt>
            <dd>
              <span class="intermediate">Grafana</span> / <span class="advanced"
                >Prometheus</span
              > / <span class="advanced">Elasticsearch</span>
            </dd>
          </dl>
        </div>

        <div
          class="separator"
          role="separator"
          data-label-top="Hard Skills"
          data-label-bottom="Soft Skills"
        >
        </div>

        <div class="soft-skills">
          <ul>
            <li><span class="expert highlight">Written Communication</span></li>
            <li><span class="intermediate">Empathy</span></li>
            <li><span class="expert highlight">Note-taking</span></li>
            <li><span class="beginner">Active Listening</span></li>
            <li>
              <span class="intermediate hightlight">Challenge Others</span>
            </li>
            <li><span class="expert highlight">System Thinking</span></li>
            <li>
              <!-- Humor is subjective = use different levels -->
              <span class="highlight"
                ><span class="advanced">H</span><span class="intermediate"
                  >u</span
                ><span class="beginner">m</span><span class="master">o</span
                ><span class="intermediate">r</span>
              </span>
              <li><span class="intermediate">Constructive Feedback</span></li>
            </li>
            <li><span class="advanced">Second-Order Thinking</span></li>
          </ul>
        </div>
      </section>

      <section id="informations">
        <div id="languages">
          <h4 class="title">Languages</h4>
          <div class="languages">
            <dl>
              <dt>French</dt>
              <dd>
                <span class="competency acquired"></span>
                <span class="competency acquired"></span>
                <span class="competency acquired"></span>
                <span class="competency acquired"></span>
              </dd>
              <dt>English</dt>
              <dd>
                <span class="competency acquired"></span>
                <span class="competency acquired">
                  <MicrophoneIcon size={12} weight="fill" />
                  <div class="tooltip">
                    I lack automatism and confidence due to a lack of practice.
                  </div>
                </span>
                <span class="competency acquired">
                  <PencilSimpleIcon size={12} weight="fill" />
                  <div class="tooltip">
                    I sometimes use English inadvertently in the middle of
                    documents written in French.
                  </div>
                </span>
                <span class="competency acquired">
                  <EyesIcon size={12} weight="fill" />
                  <div class="tooltip">
                    I've read more than 1000 English books.
                  </div>
                </span>
              </dd>
            </dl>
          </div>
        </div>

        <div id="personality">
          <h4 class="title">Personality</h4>

          <dl>
            <dt>Introvert</dt>
            <dd>Think through writing.</dd>

            <dt>Curious</dt>
            <dd>
              Ask more questions than have answers.<sup class="footref">1</sup>

              <dt>Open-Minded <sup class="footref">2</sup></dt>
              <dd>Comfortable with uncomfortable ideas.</dd>

              <dt>Humble</dt>
              <dd>Better to look stupid than to feel smart.</dd>

              <dt>Playful</dt>
              <dd>Life is too short to be serious.</dd>

              <dt>People-oriented</dt>
              <dd>Work is a human adventure.</dd>
            </dd>
          </dl>

          <div id="hobbies" class="hobbies">
            <h4 class="title">Hobbies</h4>
            <p>
              I love <HeartIcon size={14} weight="fill" aria-label="Love" /> reading nonfiction
              <BookIcon size={14} weight="fill" aria-label="Book" /> (and
              stunning picture books with my kids <HeartIcon
                size={14}
                weight="fill"
                aria-label="Love"
              />), running <PersonSimpleRunIcon
                size={14}
                weight="fill"
                aria-label="Run"
              />, walking <BackpackIcon
                size={14}
                weight="fill"
                aria-label="Ruck"
              /> and playing table tennis <PingPongIcon
                size={14}
                weight="fill"
                aria-label="Table Tennis"
              />, taking family pictures <CameraIcon
                size={14}
                weight="fill"
                aria-label="Camera"
              /> and travelling&nbsp;<BoatIcon
                size={14}
                weight="fill"
                aria-label="Landscape"
              />.
            </p>
          </div>

          <div id="footnotes">
            <dl>
              <dt><sup class="footref">1</sup></dt><dd>
                ChatGPT found my questions interesting. <SmileyIcon
                  size={10}
                  weight="fill"
                />
              </dd>
              <dt><sup class="footref">2</sup></dt><dd>
                As anybody with an open mind, my opinions are likely to change.
              </dd>
            </dl>
          </div>
        </div>
      </section>
    </page>

    <!-- Second page: Projects -->
    <page id="second" size="A4" orientation="landscape">
      <section id="work-projects" class="projects">
        <div class="project postit scaleway">
          <img class="logo" src="/img/scaleway-white.svg" alt="Scaleway Logo" />
          <h4><span class="highlight">Scaleway</span></h4>
          <p class="metadata">
            <span><MapPinIcon /> Remote</span>
            <span><CalendarDotsIcon /> Since 2020</span>
          </p>
          <p>
            <TargetIcon weight="regular" size={16} /> Order your baremetal server
            (LEGACY, UEFI) with a fresh installation (Linux distribs, Windows, etc.)
            from a simple API call.
          </p>
          <p>
            <em><CheckCircleIcon weight="regular" size={16} /> Challenges</em>
            <ul>
              <li>
                Many hardware/operational issues = My problem-solving skill
                always at work
              </li>
              <li>
                <strong>Complex organizational environment</strong> = Opportunities
                to reflect
              </li>
              <li>Missing internal platform = <em>Scope very large</em></li>
            </ul>
          </p>
          <div class="technologies">
            Go, Temporal, Postgres, GitLab CI, Nomad
          </div>
        </div>
        <div class="project postit oui-sncf">
          <img class="logo" src="/img/oui-sncf-white.svg" alt="OUI.sncf Logo" />
          <h4><span class="highlight">OUI.sncf</span></h4>
          <p class="metadata">
            <span><MapPinIcon /> Lille</span>
            <span><CalendarDotsIcon /> 2016-2018</span>
          </p>
          <p>
            <TargetIcon weight="regular" size={16} /> Helped product teams understand
            their high-traffic applications by ingesting several TBs of metrics and
            logs per day.
          </p>
          <p>
            <em><CheckCircleIcon weight="regular" size={16} /> Challenges</em>
            <ul>
              <li>
                Only developer (at first) in a production team responsible to <strong
                  >automate the boring stuff</strong
                >
              </li>
              <li>
                <strong>No prior knowledge</strong> of monitoring & big data tools
              </li>
              <li>
                <strong>High volumetry and strong reliability</strong> expected
              </li>
            </ul>
          </p>
          <div class="technologies">
            Java, Python, Go, Hadoop, Elasticsearch, Graphite, Ansible
          </div>
        </div>
        <div class="project postit leroy-merlin">
          <img
            class="logo"
            src="/img/leroy-merlin-white.svg"
            alt="Leroy Merlin Logo"
          />
          <h4><span class="highlight">Leroy Merlin</span></h4>
          <p class="metadata">
            <span><MapPinIcon /> Lille</span>
            <span><CalendarDotsIcon /> 2011-2015</span>
          </p>
          <p>
            <TargetIcon weight="regular" size={16} /> Implemented large technical
            tasks required to improve the performance and the testability of the store
            sale application.
          </p>
          <p>
            <em><CheckCircleIcon weight="regular" size={16} /> Challenges</em>
            <ul>
              <li>
                <strong>Long-lasting codebase</strong> with millions of lines of code
                and almost 30 contributors
              </li>
              <li>
                Many <strong>large refactorings</strong> without causing regressions
              </li>
              <li>
                Published my first <strong>design documents</strong> in a team more
                experienced than me
              </li>
            </ul>
          </p>
          <div class="technologies">Java, Eclipse RCP, Fitnesse, JUnit</div>
        </div>
        <div class="project-more">
          <!--
            NB: Removed for brevity. Less is more.
            <div class="postit small">
              Spring Trainer at Zenika
            </div>
            <div class="postit small">
              Java Consulting at Zenika
            </div>
            <div class="postit small">
              Some PHP early in my career
            </div>
          -->
          <div class="interactive-link">
            <span class="manuscript">View my full profile on</span>
            <br />▼<br />
            <a
              id="link-linkedin"
              href="https://www.linkedin.com/in/julien-sobczak/"
            >
              <LinkedinLogoIcon
                size={64}
                weight="fill"
                color="black"
                aria-label="LinkedIn Logo"
              />
            </a>
          </div>
          <div class="qr-code">
            <!-- Generated using https://genqrcode.com/generator/linkedin -->
            <Image
              id="qr-linkedin"
              src={qrLinkedInImage}
              alt="View my full profile on LinkedIn"
            />
          </div>
          <div class="legend">
            <span class="manuscript">My main</span><br />
            ▲ work experiences / side projects ▶
          </div>
        </div>
      </section>
      <section id="side-projects" class="projects">
        <div class="project postit blog">
          <h4>Blog</h4>
          <p class="metadata">
            <GithubLogoIcon /><a
              href="https://github.com/julien-sobczak/blog-astro"
              ><code>julien-sobczak/blog-astro</code></a
            >
          </p>
          <p>
            <TargetIcon weight="regular" size={16} /> My sandbox. Write to understand.
            Write to learn. Never write to be read.
          </p>
          <p>
            <em><CheckCircleIcon weight="regular" size={16} /> Motivations</em>
            <ul>
              <li>To play with learning</li>
              <li>To write what I want to read</li>
              <li>To face ignorance</li>
            </ul>
          </p>
          <div class="interactive-link">
            <span class="manuscript">Browse</span>&nbsp;&nbsp;<small>▶</small
            >&nbsp;&nbsp;
            <a href="https://juliensobczak.com/">
              <LinkIcon
                size={16}
                weight="regular"
                aria-label="Browse to blog"
              />
            </a>
          </div>
          <div class="qr-code">
            <!-- https://juliensobczak.com/ -->
            <Image id="qr-blog" src={qrBlogImage} alt="View my blog" />
          </div>
          <div class="technologies">Blogger > Jekyll > Astro</div>
        </div>
        <div class="project postit the-notewriter">
          <h4>The NoteWriter</h4>
          <p class="metadata">
            <GithubLogoIcon /><a
              href="https://github.com/julien-sobczak/the-notewriter"
              ><code>julien-sobczak/the-notewriter</code></a
            >
          </p>
          <p>
            <TargetIcon weight="regular" size={16} /> Minimal CLI to process my personal
            Markdown notes (reading notes, flashcards, in-progress and future projects,
            journals, reminders, goto links).
          </p>
          <p>
            <em><CheckCircleIcon weight="regular" size={16} /> Motivations</em>
            <ul>
              <li>
                Commit on a long-term creative process:
                <ul>
                  <li>Turn my readings into projects</li>
                  <li>Automate (blog posts, reading lists)</li>
                  <li>Limit my tools (reduce distractions)</li>
                  <li>Build my commonplace book</li>
                </ul>
              </li>
            </ul>
          </p>
          <div class="interactive-link">
            <span class="manuscript">Browse</span>&nbsp;&nbsp;<small>▶</small
            >&nbsp;&nbsp;
            <a href="https://julien-sobczak.github.io/the-notewriter/">
              <LinkIcon
                size={16}
                weight="regular"
                aria-label="Browse to project"
              />
            </a>
          </div>
          <div class="qr-code">
            <!-- https://julien-sobczak.github.io/the-notewriter/ -->
            <Image
              id="qr-the-notewriter"
              src={qrTheNotewriterImage}
              alt="View the documentation of The NoteWriter project"
            />
          </div>
          <div class="technologies">Go, React/Electron, GitHub Copilot</div>
        </div>
      </section>
    </page>
  </body>
</html>
