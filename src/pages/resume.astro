---
import { Image } from 'astro:assets';
import {
  EyesIcon,
  PencilSimpleIcon,
  MicrophoneIcon,
  SmileyIcon,
  CakeIcon,
  CompassIcon,
  AtIcon,
  PhoneIcon,
  PencilIcon,
  GithubLogoIcon,
  HeartIcon,
  BookIcon,
  PingPongIcon,
  CameraIcon,
  MountainsIcon,
  PersonSimpleRunIcon,
  BackpackIcon,
  BoatIcon,
  LinkedinLogoIcon,
  SpeakerLowIcon,
  ImageIcon,
  CheckCircleIcon,
  TargetIcon,
  LinkIcon,
  CalendarDotsIcon,
  MapPinIcon,
} from '@phosphor-icons/react';
import '../styles/resume.css';
import meImage from '../assets/julien-portrait.png';
import qrLinkedInImage from '../assets/qr-linkedin-profile.png';
import qrBlogImage from '../assets/qr-blog-dark.svg';
import qrTheNotewriterImage from '../assets/qr-the-notewriter-documentation-dark.svg';
const email = import.meta.env.PERSONAL_EMAIL;
const phoneNumber = import.meta.env.PERSONAL_PHONE_NUMBER;
const birthDate = import.meta.env.PERSONAL_BIRTH_DATE;
console.log('PHONE NUMBER:', phoneNumber);
console.log('EMAIL:', email);
console.log('BIRTH DATE:', birthDate);
---

<!-- QR Codes were generated using https://www.qrcode-monkey.com/fr/ -->

<!doctype html>
<html>
<head>
  <meta charset="utf-8" />
  <title>My Resume</title>

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Source+Sans+3:ital,wght@0,200..900;1,200..900&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Source+Code+Pro:ital,wght@0,200..900;1,200..900&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@400..700&display=swap" rel="stylesheet">
</head>
<body>

  <!-- First page: Me -->
  <page id="first" size="A4" orientation="landscape">

    <header>

      <div id="name">
        <h2>Julien</h2>
        <h1>Sobczak</h1>
        <h3>{`{Software Developer + Husband + Dad}`}</h3>
      </div>

      <div id="picture">
        <Image src={meImage} alt="It's me" />
      </div>

      <div id="tagline" class="speech">
        Serious about my work without never taking myself too seriously.
        <sup id="play-tagline-audio"><SpeakerLowIcon size={16} weight="fill" aria-label="I'm serious but playful" /></sup>
        <script type="text/javascript" is:inline>
          document.addEventListener('DOMContentLoaded', function () {
            const btn = document.getElementById('play-tagline-audio');
            if (btn) {
              btn.addEventListener('click', function () {
                new Audio('/img/resume-me.wav').play();
              });
            }
          });
        </script>
      </div>

      <ul id="contact">
        {birthDate && (
          <li><span class="picto"><CakeIcon size={16} weight="fill" aria-label="Birthday" /></span> {birthDate}</li>
        )}
        <li><span class="picto"><CompassIcon size={16} weight="fill" aria-label="Location" /></span> Douai, France</li>
        {email && (
          <li><span class="picto"><AtIcon size={16} weight="fill" aria-label="Email" /></span> {email}</li>
        )}
        {phoneNumber && (
          <li><span class="picto"><PhoneIcon size={16} weight="fill" aria-label="Phone" /></span> {phoneNumber}</li>
        )}
        <li><span class="picto"><PencilIcon size={16} weight="fill" aria-label="Website" /></span> https://www.juliensobczak.com</li>
        <li><span class="picto"><GithubLogoIcon size={16} weight="fill" aria-label="GitHub" /></span> https://github.com/julien-sobczak</li>
      </ul>
    </header>

    <section id="skills">
      <div class="legend">
        <span class="ignorant">Ignorance</span>...<span class="master">Mastery</span> / <span class="highlight manuscript">Love to do</span>
      </div>
      <div class="hard-skills">
        <dl>
          <dt>Code</dt>
          <dd><span class="expert highlight">Go</span> / <span class="intermediate">Python</span> / <span class="advanced">Java</span> / <span class="intermediate">JavaScript</span> / <span class="beginner">Bash</span> / <span class="advanced">SQL</span> / <span class="expert">Git</span> / <span class="intermediate highlight">CSS</span> / <span class="intermediate">React.js</span> / <span class="beginner">AI-Assisted Programming</span></dd>

          <dt>Design</dt>
          <dd><span class="advanced">System Design</span> / <span class="intermediate">Design Patterns</span> / <span class="advanced highlight">DDD</span> / <span class="advanced highlight">Automated Testing</span> / <span class="advanced">REST</span> / <span class="intermediate">gRPC</span></dd>

          <dt>Build</dt>
          <dd><span class="advanced">GitLab CI</span> / <span class="intermediate">GitHub Actions</span></dd>

          <dt>Ship</dt>
          <dd><span class="advanced">Linux</span> / <span class="advanced">Docker</span> / <span class="beginner highlight">Kubernetes</span> / <span class="intermediate">Ansible</span></dd>

          <dt>Run</dt>
          <dd><span class="intermediate">Grafana</span> / <span class="advanced">Prometheus</span> / <span class="advanced">Elasticsearch</span></dd>
        </dl>
      </div>

      <div class="separator"
          role="separator"
          data-label-top="Hard Skills"
          data-label-bottom="Soft Skills" />

      <div class="soft-skills">
        <ul>
          <li><span class="expert highlight">Written Communication</span></li>
          <li><span class="intermediate">Empathy</span></li>
          <li><span class="expert highlight">Note-taking</span></li>
          <li><span class="intermediate">Lateral Thinking</span></li>
          <li><span class="advanced">Second-order Thinking</span></li>
          <li><span class="intermediate">Humility</span></li>
          <li><span class="beginner">Active Listening</span></li>
          <li><span class="intermediate hightlight">Challenge Others</span></li>
          <li>
            <!-- Humor is subjective = use different levels -->
            <span class="highlight"><span class="advanced">H</span><span class="intermediate">u</span><span class="beginner">m</span><span class="master">o</span><span class="intermediate">r</span>
          </li>
          <li><span class="intermediate">Constructive Feedback</span></li>
        </ul>
      </div>
    </section>

    <section id="informations">
      <div id="languages">
        <h4 class="title">Languages</h4>
        <div class="languages">
          <dl>
            <dt>French</dt>
            <dd>
              <span class="competency acquired"></span>
              <span class="competency acquired"></span>
              <span class="competency acquired"></span>
              <span class="competency acquired"></span>
            </dd>
            <dt>English</dt>
            <dd>
              <span class="competency acquired"></span>
              <span class="competency acquired">
                <MicrophoneIcon size={12} weight="fill" />
                <div class="tooltip">I lack automatism and confidence due to lack of practice.</div>
              </span>
              <span class="competency almost-acquired">
                <PencilSimpleIcon size={12} weight="fill" />
                <div class="tooltip">I sometimes use English without realizing it in the middle of documents in French.</div>
              </span>
              <span class="competency half-acquired">
                <EyesIcon size={12} weight="fill" />
                <div class="tooltip">I've read more than 1000 books in English.</div>
              </span>
            </dd>
          </dl>
        </div>
      </div>

      <div id="personality">
        <h4 class="title">Personality</h4>

        <dl>
          <dt>Introvert</dt>
          <dd>Think through writing.</dd>

          <dt>Curious</dt>
          <dd>Ask more questions than have answers.<sup class="footref">1</sup>

          <dt>Open-Minded <sup class="footref">2</sup></dt>
          <dd>Comfortable with uncomfortable ideas.</dd>

          <dt>Modest</dt>
          <dd>Better to look stupid than to feel smart.</dd>

          <dt>Playful</dt>
          <dd>Life is too short to be serious.</dd>

          <dt>People-oriented</dt>
          <dd>Work is a human adventure; the rest is secondary.</dd>
        </dl>
      </div>

      <div id="hobbies" class="hobbies">
        <h4 class="title">Hobbies</h4>
        <p>
          I <HeartIcon size={14} weight="fill" aria-label="Love" /> reading <BookIcon size={14} weight="fill" aria-label="Book" /> for growth (and stunning <ImageIcon size={14} weight="fill" aria-label="Picture" /> books with my kids <HeartIcon size={14} weight="fill" aria-label="Love" />), running <PersonSimpleRunIcon size={14} weight="fill" aria-label="Run" />, walking <BackpackIcon size={14} weight="fill" aria-label="Ruck" /> and playing table tennis <PingPongIcon size={14} weight="fill" aria-label="Table Tennis" />, taking family pictures <CameraIcon size={14} weight="fill" aria-label="Camera" /> or when traveling on land <MountainsIcon size={14} weight="fill" aria-label="Landscape" /> or sea <BoatIcon size={14} weight="fill" aria-label="Sea" />.
        </p>
      </div>

      <div id="footnotes">
        <dl>
          <dt><sup class="footref">1</sup></dt><dd> ChatGPT found my questions interesting. <SmileyIcon size={10} weight="fill" /></dd>
          <dt><sup class="footref">2</sup></dt><dd> As anybody with an open mind, my opinions are likely to change.</dd>
        </dl>
      </div>
    </section>
  </page>

  <!-- Second page: Projects -->
  <page id="second" size="A4" orientation="landscape">
    <section id="work-projects" class="projects">
      <div class="project postit">
        <h4>Scaleway</h4>
        <p class="metadata"><span><MapPinIcon /> Remote</span> <span><CalendarDotsIcon /> Since 2020</span></p>
        <p><TargetIcon weight="regular" size={16} /> Order your baremetal server (LEGACY, UEFI) with a fresh installation (Linux distribs, Windows, etc.) from a simple API call.</p>
        <p>
          <em><CheckCircleIcon weight="regular" size={16} /> Challenges</em>
          <ul>
            <li>Many hardware/operational issues = <em>My problem-solving skill always at work</em></li>
            <li>Complex organizational environment = <em>Opportunities to reflect</em></li>
            <li>Missing internal platform = <em>Scope very large</em></li>
          </ul>
        </p>
        <div class="technologies">
          Go, Temporal, Postgres, GitLab CI, Nomad
        </div>
      </div>
      <div class="project postit">
        <h4>OUI.sncf</h4>
        <p class="metadata"><span><MapPinIcon /> Lille</span> <span><CalendarDotsIcon /> 2016-2018</span></p>
        <p><TargetIcon weight="regular" size={16} /> Help product teams understand their high-traffic applications with hundreds of GBs of metrics, logs and several TBs of Hadoop data.</p>
        <p>
          <em><CheckCircleIcon weight="regular" size={16} /> Challenges</em>
          <ul>
            <li>Only developer (at first) in a production team responsible to automate the boring stuff</li>
            <li>No prior knowledge of monitoring & big data tools</li>
            <li>High volumetry and strong reliability expected</li>
          </ul>
        </p>
        <div class="technologies">
          Java, Python, Go, Bash, Hadoop, Elasticsearch, Graphite, Ansible
        </div>
      </div>
      <div class="project postit">
        <h4>Adeo</h4>
        <p class="metadata"><span><MapPinIcon /> Lille</span> <span><CalendarDotsIcon /> 2011-2015</span></p>
        <p><TargetIcon weight="regular" size={16} /> Implemented large technical tasks required to improve the performance and the testability of the store sale application</p>
        <p>
          <em><CheckCircleIcon weight="regular" size={16} /> Challenges</em>
          <ul>
            <li>Long-lasting codebase with millions lines of code and almost 30 contributors</li>
            <li>Many large refactorings without causing regressions</li>
            <li>Published my first design documents in a team more experienced than me</li>
          </ul>
        </p>
        <div class="technologies">
          Java, Eclipse RCP, Fitnesse, JUnit
        </div>
      </div>
      <div class="project-more">
        <div class="postit small">
          Spring Trainer at Zenika
        </div>
        <div class="postit small">
          Java Consulting at Zenika
        </div>
        <div class="postit small">
          Some PHP early in my career
        </div>
        <div class="interactive-link">
          <span class="manuscript">View my full profile on</span>
          <br/>▼<br/>
          <a id="link-linkedin" href="https://www.linkedin.com/in/julien-sobczak-56780a91/">
            <LinkedinLogoIcon size={64} weight="fill" color="black" aria-label="LinkedIn Logo" />
          </a>
        </div>
        <div class="qr-code">
          <!-- https://juliensobczak.com/ -->
          <Image id="qr-linkedin" src={qrLinkedInImage} alt="View my full profile on LinkedIn" />
        </div>
        <div class="legend">
          ▲ <span class="manuscript">A few</span> work experiences / <span class="manuscript">My main</span> side projects ▶
        </div>
      </div>
    </section>
    <section id="side-projects" class="projects">
      <div class="project postit">
        <h4>Blog</h4>
        <p class="metadata"><GithubLogoIcon /><a href="https://github.com/julien-sobczak/blog-astro"><code>julien-sobczak/blog-astro</code></a></p>
        <p><TargetIcon weight="regular" size={16} /> My sandbox. Write to understand. Write to learn. Never write to be read.</p>
        <p>
          <em><CheckCircleIcon weight="regular" size={16} /> Motivations</em>
          <ul>
            <li>To play with learning</li>
            <li><del>to be read</del> → <ins>to write what I want to read</ins></li>
            <li><del>to feel knowledgeable</del> → <ins>to face ignorance</ins></li>
          </ul>
        </p>
        <div class="interactive-link">
          <span class="manuscript">Browse</span>&nbsp;&nbsp;<small>▶</small>&nbsp;&nbsp;
          <a href="https://juliensobczak.com/">
            <LinkIcon size={32} weight="regular" aria-label="Browse to blog" />
          </a>
        </div>
        <div class="qr-code">
          <!-- https://juliensobczak.com/ -->
          <Image id="qr-blog" src={qrBlogImage} alt="View my blog" />
        </div>
        <div class="technologies">
          Blogger > Jekyll > Astro
        </div>
      </div>
      <div class="project postit">
        <h4>The NoteWriter</h4>
        <p class="metadata"><GithubLogoIcon /><a href="https://github.com/julien-sobczak/the-notewriter"><code>julien-sobczak/the-notewriter</code></a></p>
        <p><TargetIcon weight="regular" size={16} /> Minimal CLI to process my personal Markdown notes (reading notes, flashcards, in-progress and future projects, journals, reminders, goto links).</p>
        <p>
          <em><CheckCircleIcon weight="regular" size={16} /> Motivations</em>
          <ul>
            <li><del>Showcase a OSS project</del><br/>→ <ins>Commit on a long-term creative process:</ins>
              <ul>
                <li>Turn my readings into projects</li>
                <li>Automate (blog posts, reading lists)</li>
                <li>Limit my tools (reduce distractions)</li>
                <li>Design my commonplace book</li>
              </ul>
            </li>
          </ul>
        </p>
        <div class="interactive-link">
          <span class="manuscript">Browse</span>&nbsp;&nbsp;<small>▶</small>&nbsp;&nbsp;
          <a href="https://julien-sobczak.github.io/the-notewriter/">
            <LinkIcon size={32} weight="regular" aria-label="Browse to project" />
          </a>
        </div>
        <div class="qr-code">
          <!-- https://julien-sobczak.github.io/the-notewriter/ -->
          <Image id="qr-the-notewriter" src={qrTheNotewriterImage} alt="View the documentation of The NoteWriter project" />
        </div>
        <div class="technologies">
          Go, React/Electron
        </div>
      </div>
    </section>
  </page>
</body>
</html>
