---
import { getCollection } from "astro:content";
import PageLayout from "../../layouts/PageLayout.astro";
import ReadingListOrBlogPostList from "../../components/ReadingListOrBlogPostList.jsx";
const posts = await getCollection("read");
posts.reverse();
---

<PageLayout
  category="read"
  contentBased={false}
  pageTitle="Julien Sobczak | Reading"
>
  <section class="category-content">
    <!-- We don't render the page heading to customize it in below component (readings vs reviews) -->
    <ReadingListOrBlogPostList posts={posts} client:only="react" />
  </section>
</PageLayout>
