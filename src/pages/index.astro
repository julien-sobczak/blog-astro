---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const sortByDate = (a, b) => {
  return new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf();
};

const allBlogPostsRead = await getCollection("read", ({ data }) => {
  return import.meta.env.PROD ? data.draft !== true : true;
});
const allBlogPostsWrite = await getCollection("write", ({ data }) => {
  return import.meta.env.PROD ? data.draft !== true : true;
});
const allBlogPostsInspect = await getCollection("inspect", ({ data }) => {
  return import.meta.env.PROD ? data.draft !== true : true;
});
const recentBlogPostsRead = allBlogPostsRead.sort(sortByDate).slice(0, 3);
const recentBlogPostsWrite = allBlogPostsWrite.sort(sortByDate).slice(0, 3);
const recentBlogPostsInspect = allBlogPostsInspect.sort(sortByDate).slice(0, 3);
---

<BaseLayout id="page-home" pageTitle="Julien Sobczak">
  <!-- Navigation -->

  <nav id="mainNav" class="navbar-default">
    <div class="container">
      <a class="navbar-brand" href="#page-top"
        >Julien Sobczak <span id="subtitle">
          | <small class="manuscript">Reading. Coding. Growing.</small></span
        ></a
      >
      <div class="navbar-collabsible">
        <input
          id="collapsible"
          class="navbar-checkbox-toggle"
          type="checkbox"
        />
        <label for="collapsible" class="navbar-label-toggle"
          >Menu <i class="fas fa-bars"></i></label
        >
        <div class="navbar-collapse">
          <ul>
            <li>
              <a class="nav-link" href="#about-blog">About This Blog</a>
            </li>
            <li>
              <a class="nav-link" href="#about-me">About Me</a>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </nav>

  <!-- Header -->
  <header id="page-top">
    <div class="container">
      <div id="logo">
        <img src="/img/me-40yo-portrait.jpg" />
      </div>
      <div class="intro-text">
        <span class="author manuscript">Julien Sobczak, Programmer</span>
        <hr class="star-light" />
        <span class="headline">Diary of a Life Long Learner</span>
        <blockquote>
          <q class="manuscript"
            >Live as if you were to die tomorrow. Learn as if you were to live
            forever</q
          > — Gandhi
        </blockquote>
      </div>
    </div>
  </header>

  <!-- Portfolio Grid Section -->
  <section id="about-blog" class="widescreen">
    <div class="container">
      <div>
        <h2>About this blog</h2>
        <hr class="star-primary" />
      </div>
    </div>
    <div class="container">
      <div class="categories">
        <div>
          <a href="/categories/read"><img src="/img/imreadinit-icon.png" /></a>
          <a href="/categories/read"
            ><h3>I'm <span class="text-colored">Read</span>ing</h3></a
          >
          <p class="manuscript">
            Find your next technical (or not) book and expand your knowledge
          </p>
          <ul>
            <li>Latest books:</li>
            {
              recentBlogPostsRead.map((post, i) => {
                return (
                  <li>
                    <a href={`/read/${post.slug}`}>
                      {post.data.shortTitle
                        ? post.data.shortTitle
                        : post.data.title}
                      {i !== recentBlogPostsRead.length - 1 ? "," : ""}
                    </a>
                  </li>
                );
              })
            }
            <li>or see them <a href="/categories/read">all</a>!</li>
          </ul>
          <!-- TODO
          Doing
          Discover personal projects that could help you while learning
          Highlighted project: evolutio. Your companion to read faster, retain more, or train your brain.
        -->
          <div>
            <a href="/categories/write"
              ><img src="/img/imwritinit-icon.png" /></a
            >
            <a href="/categories/write"
              ><h3>I'm <span class="text-colored">Writ</span>ing</h3></a
            >
            <p class="manuscript">
              Various posts or essays mainly about productivity, learning, soft
              skills and personal development
            </p>
            <ul>
              <li>Read the latest posts about</li>
              {
                recentBlogPostsWrite.map((post, i) => {
                  return (
                    <li>
                      <a href={`/write/${post.slug}`}>
                        {post.data.subject}
                        {i !== recentBlogPostsWrite.length - 1 ? "," : ""}
                      </a>
                    </li>
                  );
                })
              }
              <li>or see them <a href="/categories/write">all</a>!</li>
            </ul>
            <div>
              <a href="/categories/inspect"
                ><img src="/img/iminspectinit-icon.png" /></a
              >
              <a href="/categories/inspect"
                ><h3>I'm <span class="text-colored">Understand</span>ing</h3></a
              >
              <p class="manuscript">
                Stand on the shoulders of giants by learning techniques from top
                developers.
              </p>
              <ul>
                <li>
                  Discover the inner working of famous OSS projects or
                  programming languages:
                </li>
                {
                  recentBlogPostsInspect.map((post, i) => {
                    return (
                      <li>
                        <a href={`/inspect/${post.slug}`}>
                          {post.data.subject}
                          {i !== recentBlogPostsInspect.length - 1 ? "," : ""}
                        </a>
                      </li>
                    );
                  })
                }
                <li>or see them <a href="/categories/inspect">all</a>!</li>
              </ul>
            </div>
            <a
              href="/categories/all"
              class="btn btn-lg btn-outline btn-outline-colored"
            >
              <i class="fas fa-list"></i> View All Posts
            </a>
          </div>
        </div>

        <!-- About Section -->
        <section class="colored" id="about-me" style="position: relative">
          <div class="container">
            <div>
              <div>
                <h2>About me</h2>
                <hr class="star-light" />
              </div>
            </div>
            <div class="row">
              <div class="col">
                <p>
                  My name is <strong>Julien Sobczak</strong>. <br />I am a <strong
                    >software developer</strong
                  >.
                </p>
                <p>
                  I don't really know why I decided to study programming, but my
                  passion has never faded since. <strong
                    >I love walking at the frontier between ignorance and
                    understanding</strong
                  >.
                </p>
                <p>
                  I love learning, and software development has revealed itself
                  as a thrilling environment for my curious mind.
                </p>
              </div>
              <div class="col">
                <p>
                  I've worked with many languages in different organizational
                  and technical environments. I don't care about technology
                  trends or my job title. <strong
                    >What I like the most is solving concrete problems.</strong>
                </p>
                <p>
                  I'm an introvert and a slow thinker, which means <strong
                    >I use writing as my preferred thinking tool</strong
                  >. I care about delivering serious work in the most playful
                  way. I love feeling stupid. I've planned to be smart in
                  another life.
                </p>
              </div>
            </div>
            <div>
              <a href="/resume" class="btn btn-lg btn-outline">
                <i class="fas fa-user"></i> View my resume
              </a>
            </div>
          </div>
        </section>
      </div>
    </div>
  </section></BaseLayout
>
